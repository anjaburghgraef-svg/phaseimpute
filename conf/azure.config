/*
 * Azure Batch profile for nf-core/phaseimpute
 * VM sizes mapped to actual process requirements
 */

process {
    executor = 'azurebatch'

    // Default: smallest general-purpose VM
    machineType = 'Standard_D2s_v5'  // 2 vCPU, 8 GB

    // ============================================
    // HIGH MEMORY PROCESSES (E-series)
    // ============================================

    // scales with target samples
    withName: '.*BCFTOOLS_PLUGINSPLIT.*' {
        machineType = 'Standard_E16s_v5'  // 16 vCPU, 128 GB
    }

    // scales with target samples + markers
    withName: '.*PLINK_VCF_BEAGLE5.*' {
        machineType = 'Standard_E16s_v5'  // 16 vCPU, 128 GB
    }

    // scales with samples + markers
    withName: '.*BEAGLE5_BEAGLE.*' {
        machineType = 'Standard_E16s_v5'  // 16 vCPU, 128 GB
    }

    // scales with panel size
    withName: '.*CONCAT_PANEL.*' {
        machineType = 'Standard_E4s_v5'   // 4 vCPU, 32 GB
    }

    // scales with samples + chromosomes
    withName: '.*CONFORMGT.*' {
        machineType = 'Standard_E4s_v5'   // 4 vCPU, 32 GB
    }

    // ============================================
    // MEDIUM PROCESSES (D-series)
    // ============================================

    // (chunks x chromosomes)
    withName: '.*SHAPEIT5_PHASECOMMON.*' {
        machineType = 'Standard_D2s_v5'   // 2 vCPU, 8 GB
    }

    // ============================================
    // LONG-RUNNING PROCESSES
    // ============================================

    // consider bumping CPU for faster I/O
    withName: '.*VCFLIB_VCFFIXUP.*' {
        machineType = 'Standard_D4s_v5'   // 4 vCPU, 16 GB
    }

    // ============================================
    // LABEL-BASED FALLBACKS (for unlisted processes)
    // ============================================

    withLabel:process_single {
        machineType = 'Standard_D2s_v5'   // 2 vCPU, 8 GB
    }
    withLabel:process_low {
        machineType = 'Standard_D4s_v5'   // 4 vCPU, 16 GB
    }
    withLabel:process_medium {
        machineType = 'Standard_D8s_v5'   // 8 vCPU, 32 GB
    }
    withLabel:process_high {
        machineType = 'Standard_D16s_v5'  // 16 vCPU, 64 GB
    }
    withLabel:process_high_memory {
        machineType = 'Standard_E32s_v5'  // 32 vCPU, 256 GB
    }
}
