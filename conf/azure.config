/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Azure Batch Configuration for nf-core/phaseimpute
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    This config maps each pipeline process to an appropriate Azure VM size based on
    measured resource usage from production runs. VM sizes are chosen to minimize
    cost while ensuring sufficient memory and CPU for each process.

    VM FAMILIES USED:
    ---------------------------------------------------------------------------------
    D-series (General Purpose)     | Balanced CPU/memory ratio, cost-effective
      - Standard_D2s_v5            |   2 vCPU,   8 GB  - light tasks
      - Standard_D4s_v5            |   4 vCPU,  16 GB  - medium tasks
      - Standard_D8s_v5            |   8 vCPU,  32 GB  - heavier compute
      - Standard_D16s_v5           |  16 vCPU,  64 GB  - high compute
    ---------------------------------------------------------------------------------
    E-series (Memory Optimized)    | High memory per core, for memory-intensive work
      - Standard_E4s_v5            |   4 vCPU,  32 GB  - moderate memory
      - Standard_E8s_v5            |   8 vCPU,  64 GB  - high memory
      - Standard_E16s_v5           |  16 vCPU, 128 GB  - very high memory
      - Standard_E32s_v5           |  32 vCPU, 256 GB  - extreme memory
    ---------------------------------------------------------------------------------

    COST BOTTLENECKS TO MONITOR:
      - BCFTOOLS_PLUGINSPLIT (imputed): 5+ days on E16, scales badly with samples
      - BEAGLE5_BEAGLE / QUILT: High memory (59+ GB), long runtime
      - BCFTOOLS_STATS: Runs per-sample (thousands of parallel tasks)
      - VCFLIB_VCFFIXUP: 6+ hours runtime (low memory but slow)

    USAGE:
      nextflow run main.nf -profile azure --species layer --tools beagle5 ...

----------------------------------------------------------------------------------------
*/

process {
    executor = 'azurebatch'
    machineType = 'Standard_D2s_v5'  // Default: 2 vCPU, 8 GB


    // ==========================================================================
    // HIGH MEMORY - E-series (memory-optimized VMs)
    // ==========================================================================

    // Imputation tools - high memory requirements
    withName: '.*BEAGLE5_BEAGLE.*'       { machineType = 'Standard_E16s_v5' }  // 59 GB observed
    withName: '.*QUILT_QUILT.*'          { machineType = 'Standard_E16s_v5' }  // similar to BEAGLE5
    withName: '.*STITCH.*'               { machineType = 'Standard_E8s_v5'  }  // scales with K param

    // Post-imputation processing - very high memory
    withName: '.*BCFTOOLS_PLUGINSPLIT.*' { machineType = 'Standard_E16s_v5' }  // 81 GB observed
    withName: '.*PLINK_VCF.*'            { machineType = 'Standard_E16s_v5' }  // 65 GB observed

    // Panel & reference processing - moderate-high memory
    withName: '.*MINIMAC4.*'             { machineType = 'Standard_E4s_v5'  }  // moderate memory
    withName: '.*CONCAT_PANEL.*'         { machineType = 'Standard_E4s_v5'  }  // 9.7 GB observed
    withName: '.*CONFORMGT.*'            { machineType = 'Standard_E4s_v5'  }  // 8.5 GB observed


    // ==========================================================================
    // IMPUTATION & PHASING - D-series (general purpose)
    // ==========================================================================

    // GLIMPSE1
    withName: '.*GLIMPSE_PHASE.*'        { machineType = 'Standard_D4s_v5'  }
    withName: '.*GLIMPSE_LIGATE.*'       { machineType = 'Standard_D2s_v5'  }
    withName: '.*GLIMPSE_CHUNK.*'        { machineType = 'Standard_D2s_v5'  }

    // GLIMPSE2
    withName: '.*GLIMPSE2_PHASE.*'       { machineType = 'Standard_D4s_v5'  }
    withName: '.*GLIMPSE2_LIGATE.*'      { machineType = 'Standard_D2s_v5'  }
    withName: '.*GLIMPSE2_CHUNK.*'       { machineType = 'Standard_D2s_v5'  }
    withName: '.*GLIMPSE2_CONCORDANCE.*' { machineType = 'Standard_D2s_v5'  }

    // SHAPEIT5 (runs many tasks: chunks x chromosomes)
    withName: '.*SHAPEIT5_PHASECOMMON.*' { machineType = 'Standard_D2s_v5'  }
    withName: '.*SHAPEIT5_LIGATE.*'      { machineType = 'Standard_D2s_v5'  }


    // ==========================================================================
    // BCFTOOLS UTILITIES
    // ==========================================================================

    withName: '.*BCFTOOLS_MPILEUP.*'     { machineType = 'Standard_D8s_v5'  }  // memory-heavy
    withName: '.*BCFTOOLS_MERGE.*'       { machineType = 'Standard_D4s_v5'  }
    withName: '.*BCFTOOLS_NORM.*'        { machineType = 'Standard_D2s_v5'  }
    withName: '.*BCFTOOLS_VIEW.*'        { machineType = 'Standard_D2s_v5'  }
    withName: '.*BCFTOOLS_INDEX.*'       { machineType = 'Standard_D2s_v5'  }
    withName: '.*BCFTOOLS_STATS.*'       { machineType = 'Standard_D2s_v5'  }  // runs per-sample!
    withName: '.*BCFTOOLS_CONCAT.*'      { machineType = 'Standard_D2s_v5'  }
    withName: '.*BCFTOOLS_ANNOTATE.*'    { machineType = 'Standard_D2s_v5'  }
    withName: '.*BCFTOOLS_CONVERT.*'     { machineType = 'Standard_D2s_v5'  }
    withName: '.*BCFTOOLS_QUERY.*'       { machineType = 'Standard_D2s_v5'  }


    // ==========================================================================
    // FORMAT CONVERSION & REFERENCE PREPARATION
    // ==========================================================================

    withName: '.*VCFLIB_VCFFIXUP.*'      { machineType = 'Standard_D4s_v5'  }  // 6+ hours runtime
    withName: '.*PLINK_TEXT_TO_BINARY.*' { machineType = 'Standard_D4s_v5'  }
    withName: '.*PLINK_TO_VCF.*'         { machineType = 'Standard_D4s_v5'  }
    withName: '.*MIXBLUP_TO_PLINK.*'     { machineType = 'Standard_D4s_v5'  }
    withName: '.*PREPARE_GENOME.*'       { machineType = 'Standard_D4s_v5'  }
    withName: '.*BAMCHREXTRACT.*'        { machineType = 'Standard_D2s_v5'  }
    withName: '.*VCFCHREXTRACT.*'        { machineType = 'Standard_D2s_v5'  }


    // ==========================================================================
    // LIGHT UTILITIES
    // ==========================================================================

    withName: '.*SAMTOOLS.*'             { machineType = 'Standard_D2s_v5'  }
    withName: '.*TABIX.*'                { machineType = 'Standard_D2s_v5'  }
    withName: '.*BEDTOOLS.*'             { machineType = 'Standard_D2s_v5'  }
    withName: '.*GAWK.*'                 { machineType = 'Standard_D2s_v5'  }
    withName: '.*GUNZIP.*'               { machineType = 'Standard_D2s_v5'  }
    withName: '.*MULTIQC.*'              { machineType = 'Standard_D2s_v5'  }


    // ==========================================================================
    // FALLBACKS (for any unlisted processes, based on nf-core labels)
    // ==========================================================================

    withLabel:process_single      { machineType = 'Standard_D2s_v5'  }  //  2 vCPU,   8 GB
    withLabel:process_low         { machineType = 'Standard_D4s_v5'  }  //  4 vCPU,  16 GB
    withLabel:process_medium      { machineType = 'Standard_D8s_v5'  }  //  8 vCPU,  32 GB
    withLabel:process_high        { machineType = 'Standard_D16s_v5' }  // 16 vCPU,  64 GB
    withLabel:process_high_memory { machineType = 'Standard_E32s_v5' }  // 32 vCPU, 256 GB
}
