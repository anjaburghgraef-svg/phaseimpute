/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Sample scale: high (> 2000 target samples)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource allocations for sample-count-dependent processes.
    Use with: --sample_scale high

    Real-world example: 5000 pig samples took 2+ days for PLUGINSPLIT alone.
    Time allocations are conservative to avoid job timeouts.
----------------------------------------------------------------------------------------
*/

process {
    withName: /.*BCFTOOLS_PLUGINSPLIT$/ {
        memory = '128 GB'
        cpus = 8
        time = '240h'  // 10 days - conservative for 5000+ samples
    }

    withName: /.*PLINK_VCF.*/ {
        memory = '80 GB'
        cpus = 8
        time = '12h'
    }

    withName: 'CONFORMGT' {
        memory = '48 GB'
        cpus = 4
        time = '4h'
    }

    withName: /.*BCFTOOLS_VIEW_EXTRACT.*/ {
        time   = '12h'
        memory = '32 GB'
        cpus   = 4
    }
}
