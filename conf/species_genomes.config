/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for Hendrix Genetics species reference genomes
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines reference genomes for livestock and aquaculture species.
    Used with --genome parameter (e.g., --genome Sscrofa11.1)

    Genomes are automatically downloaded from Ensembl/NCBI on first use,
    converted from gzip to bgzip format, indexed, and cached for future runs.

    Two variants are provided for each genome:
    - Without chr prefix (e.g., 1, 2, 3...): Use genome name directly (e.g., Sscrofa11.1)
    - With chr prefix (e.g., chr1, chr2...): Use genome name + _chr suffix (e.g., Sscrofa11.1_chr)

    Choose the variant that matches your reference panel's chromosome naming convention.
----------------------------------------------------------------------------------------
*/

params {
    genomes {
        //=====================================================================
        // CHICKEN (Gallus gallus) - GRCg7b assembly
        // Karyotype: 2n=78 (38 autosomes + ZW), Genome size: ~1.05 Gb
        //=====================================================================

        // Without chr prefix (chromosomes: 1, 2, 3...)
        'GRCg7b' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/gallus_gallus/dna/Gallus_gallus.bGalGal1.mat.broiler.GRCg7b.dna.toplevel.fa.gz"
            add_chr     = false
        }

        // With chr prefix (chromosomes: chr1, chr2, chr3...)
        'GRCg7b_chr' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/gallus_gallus/dna/Gallus_gallus.bGalGal1.mat.broiler.GRCg7b.dna.toplevel.fa.gz"
            add_chr     = true
        }

        //=====================================================================
        // PIG (Sus scrofa) - Sscrofa11.1 assembly
        // Karyotype: 2n=38 (18 autosomes + XY), Genome size: ~2.5 Gb
        //=====================================================================

        // Without chr prefix (chromosomes: 1, 2, 3...)
        'Sscrofa11.1' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/sus_scrofa/dna/Sus_scrofa.Sscrofa11.1.dna.toplevel.fa.gz"
            add_chr     = false
        }

        // With chr prefix (chromosomes: chr1, chr2, chr3...)
        'Sscrofa11.1_chr' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/sus_scrofa/dna/Sus_scrofa.Sscrofa11.1.dna.toplevel.fa.gz"
            add_chr     = true
        }

        //=====================================================================
        // TURKEY (Meleagris gallopavo) - Turkey_5.1 assembly
        // Karyotype: 2n=80 (39 autosomes + ZW), Genome size: ~1.1 Gb
        //=====================================================================

        // Without chr prefix
        'Turkey_5.1' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/meleagris_gallopavo/dna/Meleagris_gallopavo.Turkey_5.1.dna.toplevel.fa.gz"
            add_chr     = false
        }

        // With chr prefix
        'Turkey_5.1_chr' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/meleagris_gallopavo/dna/Meleagris_gallopavo.Turkey_5.1.dna.toplevel.fa.gz"
            add_chr     = true
        }

        //=====================================================================
        // ATLANTIC SALMON (Salmo salar) - Ssal_v3.1 assembly
        // Karyotype: 2n=58 (29 pairs), Genome size: ~3.0 Gb
        //=====================================================================

        // Without chr prefix
        'Ssal_v3.1' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/salmo_salar/dna/Salmo_salar.Ssal_v3.1.dna.toplevel.fa.gz"
            add_chr     = false
        }

        // With chr prefix
        'Ssal_v3.1_chr' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/salmo_salar/dna/Salmo_salar.Ssal_v3.1.dna.toplevel.fa.gz"
            add_chr     = true
        }

        //=====================================================================
        // RAINBOW TROUT (Oncorhynchus mykiss) - USDA_OmykA_1.1 assembly
        // Karyotype: 2n=58-64 (variable), Genome size: ~2.4 Gb
        //=====================================================================

        // Without chr prefix
        'USDA_OmykA_1.1' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/oncorhynchus_mykiss/dna/Oncorhynchus_mykiss.USDA_OmykA_1.1.dna.toplevel.fa.gz"
            add_chr     = false
        }

        // With chr prefix
        'USDA_OmykA_1.1_chr' {
            fasta_url   = "ftp://ftp.ensembl.org/pub/release-114/fasta/oncorhynchus_mykiss/dna/Oncorhynchus_mykiss.USDA_OmykA_1.1.dna.toplevel.fa.gz"
            add_chr     = true
        }

        //=====================================================================
        // PACIFIC WHITE SHRIMP (Litopenaeus vannamei) - ASM378908v1 assembly
        // Karyotype: 2n=88 (44 pairs), Genome size: ~1.9 Gb
        //
        // IMPORTANT: Scaffold-level assembly only!
        // - Uses NCBI scaffold IDs (NW_020868286.1, NW_020868287.1, etc.)
        // - No chromosome-level assembly available yet
        // - Your reference panel VCF must use the SAME scaffold IDs
        // - Imputation will only work if panel and target use matching scaffold names
        //
        // TODO: Replace with chromosome-level assembly when available
        //       (check NCBI/Ensembl periodically for updated assemblies)
        //=====================================================================

        // Scaffold-level assembly (NW_020868286.1, NW_020868287.1, etc.)
        'ASM378908v1' {
            fasta_url   = "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/003/789/085/GCF_003789085.1_ASM378908v1/GCF_003789085.1_ASM378908v1_genomic.fna.gz"
            add_chr     = false
        }
    }
}
