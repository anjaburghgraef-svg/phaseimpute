// Turkey-specific parameters (Meleagris gallopavo)
// Reference: Turkey_5.1 / Mgal_WU_HG_1.0
// Genome size: ~1.1 Gb, Karyotype: 2n=80 (39 autosomes + ZW)
// Chromosome structure similar to chicken: macro, intermediate, and microchromosomes
// Largest chr: ~200 Mb, Smallest: ~3.5 Mb, Average: ~28 Mb
params.chr_set = 39

process {
    withName: '.*BEAGLE5_BEAGLE' {
        ext.args = {
            [
                'gp=true',
                'ap=true',
                "chrom=${meta.chr}",
                'ne=50',
                'iterations=10',
                'imp-segment=10',
                'imp-nsteps=10'
            ].join(' ')
        }
    }
}

process {
    withName: '.*MINIMAC4_IMPUTE' {
        stageInMode = 'copy'
        ext.args = {
            [
                '--chunk 10000000',
                '--overlap 1000000',
                '--format GT,DS,GP',
                "--chr ${meta.chr}"
            ].join(' ')
        }
    }
}

process {
    withName: '.*PLINK_VCF.*' {
        ext.args = '--make-bed --allow-extra-chr --chr-set 39'
    }
}

process {
  withName: /.*BCFTOOLS_PLUGINSPLIT$/ {
    memory = '128 GB'
    cpus = 8
    time = '80h'
  }

  withName: /.*VCFLIB_VCFFIXUP$/ {
    memory = '128 GB'
    cpus = 8
    time = '24h'
  }

  withName: /.*GLIMPSE_CHUNK$/ {
    ext.args = "--window-size 1000000"
  }

  withName: /.*GLIMPSE2_CHUNK$/ {
    ext.args = "--window-mb 1"
  }
}
