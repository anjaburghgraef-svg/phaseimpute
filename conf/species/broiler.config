// Broiler Chicken-specific parameters (Gallus gallus - meat type)
// Reference: GRCg7b (bGalGal1.mat.broiler.GRCg7b)
// Genome size: ~1.05 Gb, Karyotype: 2n=78 (38 autosomes + ZW)
// Chromosome structure: 5 macro (50-197 Mb), 5 intermediate (20-40 Mb), 28 micro (3.5-23 Mb)
// Reference panel size: ~11M variants (WGS) - same as layer
// Note: Same genome as layer but broiler-specific reference may be preferred
params.chr_set = 38

process {
    withName: '.*BEAGLE5_BEAGLE' {
        ext.args = {
            [
                'gp=true',
                'ap=true',
                "chrom=${meta.chr}",
                'ne=50',
                'iterations=10',
                'imp-segment=10',
                'imp-nsteps=10'
            ].join(' ')
        }
    }
}

process {
    withName: '.*MINIMAC4_IMPUTE' {
        stageInMode = 'copy'
        ext.args = {
            [
                '--chunk 10000000',
                '--overlap 1000000',
                '--format GT,DS,GP',
                "--chr ${meta.chr}"
            ].join(' ')
        }
    }
}

process {
    withName: '.*PLINK_VCF.*' {
        ext.args = '--make-bed --allow-extra-chr --chr-set 38'
    }
}

process {
    withName: /.*GLIMPSE_CHUNK$/ {
        ext.args = "--window-size 1000000"
    }

    withName: /.*GLIMPSE2_CHUNK$/ {
        ext.args = "--window-mb 1"
    }
}

// =============================================================================
// GENOME/PANEL SIZE DEPENDENT RESOURCES (~11M variants)
// These processes scale primarily with reference panel/genome size
// Same as layer chicken
// =============================================================================
process {
    // VCFLIB_VCFFIXUP - recalculates AC/AN fields
    // Scaling: ↑↑↑ genome size, ↑ markers
    withName: /.*VCFLIB_VCFFIXUP$/ {
        memory = '32 GB'
        cpus = 4
        time = '6h'
    }

    // BCFTOOLS_NORM - normalizes variants
    // Scaling: ↑ genome, ↑ markers
    withName: /.*BCFTOOLS_NORM$/ {
        memory = '16 GB'
        cpus = 2
        time = '30m'
    }

    // BCFTOOLS_CONCAT - concatenates panel chunks
    // Scaling: ↑ panel size, ↑ chromosomes
    withName: /.*BCFTOOLS_CONCAT$/ {
        memory = '16 GB'
        cpus = 4
        time = '1h'
    }

    // BEAGLE5_BEAGLE - imputation
    // Scaling: ↑↑ samples, ↑↑ markers, ↑ genome
    // Note: Additional memory scaling with samples handled by sample_scale config
    withName: /.*BEAGLE5_BEAGLE$/ {
        memory = '32 GB'
        cpus = 8
        time = '30m'
    }

    // BCFTOOLS_INDEX - indexes VCF files
    // Scaling: ↑ genome
    withName: /.*BCFTOOLS_INDEX$/ {
        memory = '8 GB'
        cpus = 2
        time = '15m'
    }

    // BCFTOOLS_VIEW (normalize) - views/filters VCF
    // Scaling: ↑ genome
    withName: /.*BCFTOOLS_VIEW$/ {
        memory = '8 GB'
        cpus = 2
        time = '20m'
    }

    // BCFTOOLS_ANNOTATE (chrrename) - renames chromosomes
    // Scaling: ↑ genome size
    withName: /.*BCFTOOLS_ANNOTATE$/ {
        memory = '8 GB'
        cpus = 2
        time = '1h'
    }

    // SHAPEIT5_PHASECOMMON - phasing
    // Scaling: ↑ samples, ↑ genome (many tasks)
    withName: /.*SHAPEIT5_PHASECOMMON$/ {
        memory = '4 GB'
        cpus = 2
        time = '5m'
    }
}
