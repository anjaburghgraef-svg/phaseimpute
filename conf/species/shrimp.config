// Pacific White Shrimp-specific parameters (Litopenaeus vannamei)
// Reference: ASM378908v1 (scaffold-level assembly)
// Genome size: ~1.9-2.0 Gb, Karyotype: 2n=88 (44 chromosome pairs, ZW sex determination)
// Note: High repeat content (50-64% TEs, >23% simple sequence repeats)
// Reference panel size: UNKNOWN - using moderate placeholder resources
// TODO: Calibrate resources once reference panel size is known
//
// IMPORTANT: Current reference genome is SCAFFOLD-LEVEL only!
// - Uses NCBI scaffold IDs (NW_020868286.1, NW_020868287.1, etc.)
// - Your reference panel must use the SAME scaffold naming convention
// - No chromosome-level assembly available yet - replace when one becomes available
// - Check NCBI/Ensembl periodically for chromosome-level shrimp assemblies
params.chr_set = 44

process {
    withName: '.*BEAGLE5_BEAGLE' {
        ext.args = {
            [
                'gp=true',
                'ap=true',
                "chrom=${meta.chr}",
                'ne=200',
                'iterations=15',
                'imp-segment=8',
                'imp-nsteps=12'
            ].join(' ')
        }
    }
}

process {
    withName: '.*MINIMAC4_IMPUTE' {
        stageInMode = 'copy'
        ext.args = {
            [
                '--chunk 20000000',
                '--overlap 2000000',
                '--format GT,DS,GP',
                "--chr ${meta.chr}"
            ].join(' ')
        }
    }
}

process {
    withName: '.*PLINK_VCF.*' {
        ext.args = '--make-bed --allow-extra-chr --chr-set 44'
    }
}

process {
    withName: /.*GLIMPSE_CHUNK$/ {
        ext.args = "--window-size 2000000"
    }

    withName: /.*GLIMPSE2_CHUNK$/ {
        ext.args = "--window-mb 2"
    }
}

// =============================================================================
// GENOME/PANEL SIZE DEPENDENT RESOURCES (PLACEHOLDER - needs calibration)
// Using moderate resources - adjust once reference panel size is known
// These processes scale primarily with reference panel/genome size
// =============================================================================
process {
    // VCFLIB_VCFFIXUP - recalculates AC/AN fields
    // Scaling: ↑↑↑ genome size, ↑ markers
    withName: /.*VCFLIB_VCFFIXUP$/ {
        memory = '48 GB'
        cpus = 4
        time = '8h'
    }

    // BCFTOOLS_NORM - normalizes variants
    // Scaling: ↑ genome, ↑ markers
    withName: /.*BCFTOOLS_NORM$/ {
        memory = '24 GB'
        cpus = 2
        time = '45m'
    }

    // BCFTOOLS_CONCAT - concatenates panel chunks
    // Scaling: ↑ panel size, ↑ chromosomes
    withName: /.*BCFTOOLS_CONCAT$/ {
        memory = '24 GB'
        cpus = 4
        time = '1h30m'
    }

    // BEAGLE5_BEAGLE - imputation
    // Scaling: ↑↑ samples, ↑↑ markers, ↑ genome
    // Note: Additional memory scaling with samples handled by sample_scale config
    withName: /.*BEAGLE5_BEAGLE$/ {
        memory = '48 GB'
        cpus = 10
        time = '45m'
    }

    // BCFTOOLS_INDEX - indexes VCF files
    // Scaling: ↑ genome
    withName: /.*BCFTOOLS_INDEX$/ {
        memory = '12 GB'
        cpus = 2
        time = '20m'
    }

    // BCFTOOLS_VIEW (normalize) - views/filters VCF
    // Scaling: ↑ genome
    withName: /.*BCFTOOLS_VIEW$/ {
        memory = '12 GB'
        cpus = 2
        time = '30m'
    }

    // BCFTOOLS_ANNOTATE (chrrename) - renames chromosomes
    // Scaling: ↑ genome size
    withName: /.*BCFTOOLS_ANNOTATE$/ {
        memory = '12 GB'
        cpus = 2
        time = '1h30m'
    }

    // SHAPEIT5_PHASECOMMON - phasing
    // Scaling: ↑ samples, ↑ genome (many tasks)
    withName: /.*SHAPEIT5_PHASECOMMON$/ {
        memory = '6 GB'
        cpus = 2
        time = '8m'
    }
}
