// Atlantic Salmon-specific parameters (Salmo salar)
// Reference: Ssal_v3.1
// Genome size: ~3.0 Gb, Karyotype: 2n=58 (29 chromosome pairs)
// Note: Salmonid-specific whole genome duplication ~80 MYA
// Chromosome sizes: relatively uniform, 40-160 Mb range, Average: ~100 Mb
// Reference panel size: UNKNOWN - using moderate-high placeholder resources
// TODO: Calibrate resources once reference panel size is known
params.chr_set = 29

process {
    withName: '.*BEAGLE5_BEAGLE' {
        ext.args = {
            [
                'gp=true',
                'ap=true',
                "chrom=${meta.chr}",
                'ne=100',
                'iterations=12',
                'imp-segment=10',
                'imp-nsteps=10'
            ].join(' ')
        }
    }
}

process {
    withName: '.*MINIMAC4_IMPUTE' {
        stageInMode = 'copy'
        ext.args = {
            [
                '--chunk 40000000',
                '--overlap 4000000',
                '--format GT,DS,GP',
                "--chr ${meta.chr}"
            ].join(' ')
        }
    }
}

process {
    withName: '.*PLINK_VCF.*' {
        ext.args = '--make-bed --allow-extra-chr --chr-set 29'
    }
}

process {
    withName: /.*GLIMPSE_CHUNK$/ {
        ext.args = "--window-size 4000000"
    }

    withName: /.*GLIMPSE2_CHUNK$/ {
        ext.args = "--window-mb 4"
    }
}

// =============================================================================
// GENOME/PANEL SIZE DEPENDENT RESOURCES (PLACEHOLDER - needs calibration)
// Using moderate-high resources due to larger genome size (3.0 Gb)
// These processes scale primarily with reference panel/genome size
// =============================================================================
process {
    // VCFLIB_VCFFIXUP - recalculates AC/AN fields
    // Scaling: ↑↑↑ genome size, ↑ markers
    withName: /.*VCFLIB_VCFFIXUP$/ {
        memory = '48 GB'
        cpus = 6
        time = '10h'
    }

    // BCFTOOLS_NORM - normalizes variants
    // Scaling: ↑ genome, ↑ markers
    withName: /.*BCFTOOLS_NORM$/ {
        memory = '24 GB'
        cpus = 4
        time = '1h'
    }

    // BCFTOOLS_CONCAT - concatenates panel chunks
    // Scaling: ↑ panel size, ↑ chromosomes
    withName: /.*BCFTOOLS_CONCAT$/ {
        memory = '24 GB'
        cpus = 6
        time = '1h30m'
    }

    // BEAGLE5_BEAGLE - imputation
    // Scaling: ↑↑ samples, ↑↑ markers, ↑ genome
    // Note: Additional memory scaling with samples handled by sample_scale config
    withName: /.*BEAGLE5_BEAGLE$/ {
        memory = '48 GB'
        cpus = 10
        time = '45m'
    }

    // BCFTOOLS_INDEX - indexes VCF files
    // Scaling: ↑ genome
    withName: /.*BCFTOOLS_INDEX$/ {
        memory = '12 GB'
        cpus = 2
        time = '25m'
    }

    // BCFTOOLS_VIEW (normalize) - views/filters VCF
    // Scaling: ↑ genome
    withName: /.*BCFTOOLS_VIEW$/ {
        memory = '12 GB'
        cpus = 4
        time = '35m'
    }

    // BCFTOOLS_ANNOTATE (chrrename) - renames chromosomes
    // Scaling: ↑ genome size
    withName: /.*BCFTOOLS_ANNOTATE$/ {
        memory = '12 GB'
        cpus = 4
        time = '1h30m'
    }

    // SHAPEIT5_PHASECOMMON - phasing
    // Scaling: ↑ samples, ↑ genome (many tasks)
    withName: /.*SHAPEIT5_PHASECOMMON$/ {
        memory = '6 GB'
        cpus = 4
        time = '8m'
    }
}
