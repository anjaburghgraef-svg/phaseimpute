/*
 * Azure VM mappings for Rainbow Trout (Oncorhynchus mykiss)
 * Genome: ~2.4 Gb, Reference panel: UNKNOWN
 * Using same resources as salmon (similar salmonid genome)
 */

process {
    // VCFLIB_VCFFIXUP: 48 GB on HPC (estimated from salmon)
    withName: '.*VCFLIB_VCFFIXUP.*'      { machineType = 'Standard_D16ds_v4' }   // 64 GB

    // BCFTOOLS_NORM: 24 GB on HPC
    withName: '.*BCFTOOLS_NORM.*'        { machineType = 'Standard_D8ds_v4'  }   // 32 GB

    // BCFTOOLS_CONCAT: 24 GB on HPC
    withName: '.*BCFTOOLS_CONCAT.*'      { machineType = 'Standard_D8ds_v4'  }   // 32 GB

    // BEAGLE5_BEAGLE: 48 GB on HPC
    withName: '.*BEAGLE5_BEAGLE.*'       { machineType = 'Standard_D16ds_v4' }   // 64 GB

    // BCFTOOLS_INDEX: 12 GB on HPC
    withName: '.*BCFTOOLS_INDEX.*'       { machineType = 'Standard_D4ds_v4'  }   // 16 GB

    // BCFTOOLS_VIEW: 12 GB on HPC
    withName: '.*BCFTOOLS_VIEW.*'        { machineType = 'Standard_D4ds_v4'  }   // 16 GB

    // BCFTOOLS_ANNOTATE: 12 GB on HPC
    withName: '.*BCFTOOLS_ANNOTATE.*'    { machineType = 'Standard_D4ds_v4'  }   // 16 GB

    // SHAPEIT5_PHASECOMMON: 6 GB on HPC
    withName: '.*SHAPEIT5_PHASECOMMON.*' { machineType = 'Standard_D2ds_v4'  }   // 8 GB
}
