/*
 * Azure VM mappings for Layer Chicken (Gallus gallus - egg type)
 * Genome: ~1.05 Gb, Reference panel: ~11M variants
 */

process {
    // VCFLIB_VCFFIXUP: 32 GB on HPC
    withName: '.*VCFLIB_VCFFIXUP.*'      { machineType = 'Standard_D8ds_v4'  }   // 32 GB

    // BCFTOOLS_NORM: 16 GB on HPC
    withName: '.*BCFTOOLS_NORM.*'        { machineType = 'Standard_D4ds_v4'  }   // 16 GB

    // BCFTOOLS_CONCAT: 16 GB on HPC
    withName: '.*BCFTOOLS_CONCAT.*'      { machineType = 'Standard_D4ds_v4'  }   // 16 GB

    // BEAGLE5_BEAGLE: 32 GB on HPC
    withName: '.*BEAGLE5_BEAGLE.*'       { machineType = 'Standard_D8ds_v4'  }   // 32 GB

    // BCFTOOLS_INDEX: 8 GB on HPC
    withName: '.*BCFTOOLS_INDEX.*'       { machineType = 'Standard_D2ds_v4'  }   // 8 GB

    // BCFTOOLS_VIEW: 8 GB on HPC
    withName: '.*BCFTOOLS_VIEW.*'        { machineType = 'Standard_D2ds_v4'  }   // 8 GB

    // BCFTOOLS_ANNOTATE: 8 GB on HPC
    withName: '.*BCFTOOLS_ANNOTATE.*'    { machineType = 'Standard_D2ds_v4'  }   // 8 GB

    // SHAPEIT5_PHASECOMMON: 4 GB on HPC
    withName: '.*SHAPEIT5_PHASECOMMON.*' { machineType = 'Standard_D2ds_v4'  }   // 8 GB (min available)
}
