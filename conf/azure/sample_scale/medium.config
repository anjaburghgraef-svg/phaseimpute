/*
 * Azure VM mappings for medium sample count (500-2000 target samples)
 * Default sample_scale - these processes scale primarily with sample count
 */

process {
    // BCFTOOLS_PLUGINSPLIT: 64 GB on HPC
    withName: '.*BCFTOOLS_PLUGINSPLIT.*' { machineType = 'Standard_D16ds_v4' }   // 64 GB

    // PLINK_VCF: 48 GB on HPC
    withName: '.*PLINK_VCF.*'            { machineType = 'Standard_D16ds_v4' }   // 64 GB (next available above 48)

    // CONFORMGT: 12 GB on HPC
    withName: '.*CONFORMGT.*'            { machineType = 'Standard_D4ds_v4'  }   // 16 GB
}
