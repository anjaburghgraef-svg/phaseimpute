/*
 * Azure VM mappings for high sample count (> 2000 target samples)
 * These processes scale primarily with sample count
 * Real-world example: 5000 pig samples requires substantial resources
 */

process {
    // BCFTOOLS_PLUGINSPLIT: 128 GB on HPC
    withName: '.*BCFTOOLS_PLUGINSPLIT.*' { machineType = 'Standard_D32ds_v4' }   // 128 GB

    // PLINK_VCF: 80 GB on HPC
    withName: '.*PLINK_VCF.*'            { machineType = 'Standard_D32ds_v4' }   // 128 GB (next available above 80)

    // CONFORMGT: 16 GB on HPC
    withName: '.*CONFORMGT.*'            { machineType = 'Standard_D4ds_v4'  }   // 16 GB

    // BCFTOOLS_VIEW_EXTRACT: 32 GB on HPC (only needed for high sample count)
    withName: '.*BCFTOOLS_VIEW_EXTRACT.*' { machineType = 'Standard_D8ds_v4' }   // 32 GB
}
