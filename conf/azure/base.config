/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Azure Batch Base Configuration for nf-core/phaseimpute
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Default VM mappings for all processes. Species-specific and sample_scale-specific
    configs override these defaults for processes that scale with genome size or
    sample count.

    AVAILABLE VMs (Hendrix Azure):
    ---------------------------------------------------------------------------------
    D-series v4 (General Purpose) | Balanced CPU/memory ratio
      - Standard_D2ds_v4          |   2 vCPU,   8 GB
      - Standard_D4ds_v4          |   4 vCPU,  16 GB
      - Standard_D8ds_v4          |   8 vCPU,  32 GB
      - Standard_D16ds_v4         |  16 vCPU,  64 GB
      - Standard_D32ds_v4         |  32 vCPU, 128 GB
      - Standard_D64ds_v4         |  64 vCPU, 256 GB
    ---------------------------------------------------------------------------------

    CPU LIMIT: 350 CPUs total across all running jobs

    USAGE:
      nextflow run main.nf -profile azure --species layer --sample_scale medium

----------------------------------------------------------------------------------------
*/

process {
    executor = 'azurebatch'
    machineType = 'Standard_D2ds_v4'  // Default: 2 vCPU, 8 GB


    // ==========================================================================
    // IMPUTATION & PHASING (defaults - may be overridden by species config)
    // ==========================================================================

    // GLIMPSE1
    withName: '.*GLIMPSE_PHASE.*'        { machineType = 'Standard_D4ds_v4'  }
    withName: '.*GLIMPSE_LIGATE.*'       { machineType = 'Standard_D2ds_v4'  }
    withName: '.*GLIMPSE_CHUNK.*'        { machineType = 'Standard_D2ds_v4'  }

    // GLIMPSE2
    withName: '.*GLIMPSE2_PHASE.*'       { machineType = 'Standard_D4ds_v4'  }
    withName: '.*GLIMPSE2_LIGATE.*'      { machineType = 'Standard_D2ds_v4'  }
    withName: '.*GLIMPSE2_CHUNK.*'       { machineType = 'Standard_D2ds_v4'  }
    withName: '.*GLIMPSE2_CONCORDANCE.*' { machineType = 'Standard_D2ds_v4'  }

    // QUILT & STITCH (defaults - typically need more memory)
    withName: '.*QUILT_QUILT.*'          { machineType = 'Standard_D16ds_v4' }
    withName: '.*STITCH.*'               { machineType = 'Standard_D16ds_v4' }

    // MINIMAC4
    withName: '.*MINIMAC4.*'             { machineType = 'Standard_D8ds_v4'  }


    // ==========================================================================
    // BCFTOOLS UTILITIES (defaults)
    // ==========================================================================

    withName: '.*BCFTOOLS_MPILEUP.*'     { machineType = 'Standard_D8ds_v4'  }
    withName: '.*BCFTOOLS_MERGE.*'       { machineType = 'Standard_D4ds_v4'  }
    withName: '.*BCFTOOLS_NORM.*'        { machineType = 'Standard_D4ds_v4'  }
    withName: '.*BCFTOOLS_VIEW.*'        { machineType = 'Standard_D2ds_v4'  }
    withName: '.*BCFTOOLS_INDEX.*'       { machineType = 'Standard_D2ds_v4'  }
    withName: '.*BCFTOOLS_STATS.*'       { machineType = 'Standard_D2ds_v4'  }
    withName: '.*BCFTOOLS_CONCAT.*'      { machineType = 'Standard_D4ds_v4'  }
    withName: '.*BCFTOOLS_ANNOTATE.*'    { machineType = 'Standard_D2ds_v4'  }
    withName: '.*BCFTOOLS_CONVERT.*'     { machineType = 'Standard_D2ds_v4'  }
    withName: '.*BCFTOOLS_QUERY.*'       { machineType = 'Standard_D2ds_v4'  }


    // ==========================================================================
    // FORMAT CONVERSION & REFERENCE PREPARATION
    // ==========================================================================

    withName: '.*VCFLIB_VCFFIXUP.*'      { machineType = 'Standard_D8ds_v4'  }
    withName: '.*PLINK_TEXT_TO_BINARY.*' { machineType = 'Standard_D4ds_v4'  }
    withName: '.*PLINK_TO_VCF.*'         { machineType = 'Standard_D4ds_v4'  }
    withName: '.*MIXBLUP_TO_PLINK.*'     { machineType = 'Standard_D4ds_v4'  }
    withName: '.*PREPARE_GENOME.*'       { machineType = 'Standard_D4ds_v4'  }
    withName: '.*BAMCHREXTRACT.*'        { machineType = 'Standard_D2ds_v4'  }
    withName: '.*VCFCHREXTRACT.*'        { machineType = 'Standard_D2ds_v4'  }


    // ==========================================================================
    // LIGHT UTILITIES
    // ==========================================================================

    withName: '.*SAMTOOLS.*'             { machineType = 'Standard_D2ds_v4'  }
    withName: '.*TABIX.*'                { machineType = 'Standard_D2ds_v4'  }
    withName: '.*BEDTOOLS.*'             { machineType = 'Standard_D2ds_v4'  }
    withName: '.*GAWK.*'                 { machineType = 'Standard_D2ds_v4'  }
    withName: '.*GUNZIP.*'               { machineType = 'Standard_D2ds_v4'  }
    withName: '.*MULTIQC.*'              { machineType = 'Standard_D2ds_v4'  }


    // ==========================================================================
    // FALLBACKS (for any unlisted processes, based on nf-core labels)
    // ==========================================================================

    withLabel:process_single      { machineType = 'Standard_D2ds_v4'  }  //  2 vCPU,   8 GB
    withLabel:process_low         { machineType = 'Standard_D4ds_v4'  }  //  4 vCPU,  16 GB
    withLabel:process_medium      { machineType = 'Standard_D8ds_v4'  }  //  8 vCPU,  32 GB
    withLabel:process_high        { machineType = 'Standard_D16ds_v4' }  // 16 vCPU,  64 GB
    withLabel:process_high_memory { machineType = 'Standard_D64ds_v4' }  // 64 vCPU, 256 GB
}
