/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resource allocation configuration for phaseimpute pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Memory and CPU requirements depend primarily on REFERENCE PANEL SIZE,
    not on species. Adjust these settings based on your panel size.

    Guidelines for panel size:
    - Small panel:  < 10M variants  -> Use default settings
    - Medium panel: 10-30M variants -> Consider increasing memory
    - Large panel:  > 30M variants  -> Use high memory settings below

    To use: Include this config with -c conf/resources.config
    Or copy settings to your own config file and customize.
----------------------------------------------------------------------------------------
*/

// =============================================================================
// DEFAULT SETTINGS (suitable for small to medium panels, < 30M variants)
// =============================================================================

/*
process {
    // BCFTOOLS_PLUGINSPLIT - splits multi-sample VCF
    // Memory scales with number of samples and variants
    withName: /.*BCFTOOLS_PLUGINSPLIT$/ {
        memory = '64 GB'
        cpus = 4
        time = '48h'
    }

    // VCFLIB_VCFFIXUP - recalculates AC/AN fields
    // Memory scales with number of variants
    withName: /.*VCFLIB_VCFFIXUP$/ {
        memory = '64 GB'
        cpus = 4
        time = '12h'
    }

    // BCFTOOLS_NORM - normalizes variants
    withName: /.*BCFTOOLS_NORM$/ {
        memory = '32 GB'
        cpus = 2
        time = '12h'
    }
}
*/

// =============================================================================
// HIGH MEMORY SETTINGS (for large panels, > 30M variants)
// Uncomment and adjust as needed, or copy to your own config
// =============================================================================


process {
    withName: /.*BCFTOOLS_PLUGINSPLIT$/ {
        memory = '128 GB'
        cpus = 8
        time = '100h'
    }

    withName: /.*VCFLIB_VCFFIXUP$/ {
        memory = '128 GB'
        cpus = 8
        time = '24h'
    }

    withName: /.*BCFTOOLS_NORM$/ {
        memory = '64 GB'
        cpus = 4
        time = '24h'
    }

    withName: 'GENERATE_QC_METRICS' {
        time   = '48h'
        memory = '24 GB'
        cpus   = 4
    }

     withName: 'CONFORMGT' {
        time = '4h'
        memory = '32 GB'
        cpus = 2
    }    

     withName: 'PLINK_VCF' {
        time = '6h'
        memory = '64 GB'
        cpus = 4
    }    
 
}

